# Copy to server/.env. Never commit real keys.

PORT=4000
# Public base URL of this API. Stripe return URLs and the Google redirect URI use it.
# It must be reachable from the phone or browser that completes payment.
API_PUBLIC_URL=http://localhost:4000
# Expo web origin, used when a booking asks to return to the web app.
APP_WEB_URL=http://localhost:8081

# Required in production. Any long random string is fine locally.
JWT_SECRET=replace-with-a-long-random-string

# sqlite file. Use an absolute path in production.
DB_PATH=./data/lido.sqlite

# stripe | mock
# If unset: stripe when STRIPE_SECRET_KEY is set, otherwise mock.
# Mock lets you click through booking without Stripe. It is not a real charge.
PAYMENTS_MODE=

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
# Use sk_test_... — never a live secret, and never commit the real value.
STRIPE_SECRET_KEY=
# From `stripe listen` or the webhook endpoint signing secret.
STRIPE_WEBHOOK_SECRET=

# Google OAuth web client. Redirect URI must be exactly:
#   http://localhost:4000/api/calendar/callback
# (or whatever API_PUBLIC_URL you use, plus /api/calendar/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Enables POST /api/admin/slots when set.
ADMIN_TOKEN=

# Demo swimmer is seeded outside production unless you set this to false.
SEED_DEMO_USER=true
# Echoes the demo password from GET /api/config. Forced off when NODE_ENV=production
# unless you explicitly set true. Leave false in any shared environment.
EXPOSE_DEMO_LOGIN=true

NODE_ENV=development
